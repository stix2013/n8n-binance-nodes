# ---------- Stage 1: Build the API (shared layers) ----------
ARG API_VERSION=1.7.0
FROM python:3.14-slim AS api-base

# System dependencies (minimal)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY ./api/pyproject.toml /app/pyproject.toml
# Install CPU-only PyTorch first (large wheel) then the rest of the project in one layer
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -e .

# Copy source code (needed for both API and worker)
COPY ./api /app

# ---------- Stage 2: API runtime ----------
FROM python:3.14-slim AS api-runtime
COPY --from=api-base /app /app
WORKDIR /app

# Create non-root user
RUN useradd -u 1000 -m appuser && chown -R appuser:appuser /app
USER appuser

# Healthcheck
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Entrypoint for the API server
WORKDIR /app/src
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
