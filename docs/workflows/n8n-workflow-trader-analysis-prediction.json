      "parameters": {
        "jsCode": "const symbol = $input.first().json.symbol;\nconst interval = $input.first().json.interval;\nconst result = $input.first().json.result;\nconst signals_count = result.signals_count;\nlet confidence = 0;\nlet prediction = 0;\nlet signal_type = \"WAIT\";\nlet regime = \"\";\n\nif (signals_count === 0) {\n  return [\n    {\n      symbol,\n      interval,\n      signal_type,\n      signals_count,\n      regime,\n      confidence,\n      prediction,\n    }\n  ]\n}\n\nconst [signal] = result.signals.slice(-1);\n\nregime = signal.regime;\nconfidence = signal.confidence;\nprediction = signal.prediction;\nsignal_type = signal.signal_type;\n\nreturn [{\n  symbol,\n  interval,\n  signal_type,\n  signals_count,\n  regime,\n  confidence,\n  prediction,\n}];\n"
      },
