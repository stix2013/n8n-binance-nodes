    {
      "parameters": {
        "jsCode": "// Chain to model-training-done workflow\nconst webhookUrl = 'http://localhost:5678/webhook/model-training-done';\n\nconst response = await $http.post(webhookUrl, {\n  task_id: $input.first().json.task_id,\n  symbol: $input.first().json.symbol,\n  status: $input.first().json.status,\n  result: $input.first().json.result\n});\n\nreturn [{ json: { chained: true, response: response } }];"
      },
