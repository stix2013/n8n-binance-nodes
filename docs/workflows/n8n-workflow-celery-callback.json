    {
      "parameters": {
        "jsCode": "// Chain to prediction-analysis workflow\nconst webhookUrl = 'http://localhost:5678/webhook/prediction-analysis';\n\nconst response = await $http.post(webhookUrl, {\n  task_id: $input.first().json.task_id,\n  symbol: $input.first().json.symbol,\n  signal: $input.first().json.result?.signal,\n  confidence: $input.first().json.result?.confidence,\n  status: $input.first().json.status\n});\n\nreturn [{ json: { chained: true, response: response } }];"
      },
