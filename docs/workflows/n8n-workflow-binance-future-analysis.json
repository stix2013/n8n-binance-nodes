      "parameters": {
        "jsCode": "let raw = ($input.first().json.chatInput || $input.first().json.message?.text || '').trim();\n\nif ($input.first().json.symbol) {\n  const symbol_input = $input.first().json.symbol;\n  raw = symbol_input.slice(0,-4);\n}\n\nif (!raw) throw new Error('No coin symbol provided. Send a coin like BTC, ETH, or SOL.');\n\n// Strip common suffixes if user already typed full pair\nconst coin = raw.toUpperCase().replace(/USDT$/, '').replace(/[^A-Z0-9]/g, '');\nif (!coin) throw new Error('Invalid symbol. Send a coin like BTC, ETH, or SOL.');\n\nconst symbol = coin + 'USDT';\nconst chatId = $input.first().json.message?.chat?.id || '5572228344';\nconst limit = 500;\n\nconst intervals = [\n  '15m', // for 15 minutes timeframe\n  '1h', // for 1 hour timeframe\n  '4h', // for 4 hours timeframe\n  '1m', // for 1 minute timeframe\n];\n\nreturn [{\n    chatId,\n    coin,\n    symbol,\n    limit,\n    intervals,\n  }];\n"
      },
